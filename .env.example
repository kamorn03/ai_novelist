# ===========================================
# AI Novelist Orchestrator - Environment Config
# ===========================================

# PostgreSQL Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ai_novelist
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password_here

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434

# Model Names (Ollama)
WRITER_MODEL=llama3:8b
EVALUATOR_MODEL=gemma2:9b
PLANNER_MODEL=llama3:8b

# Embedding Model (for Vector RAG)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# KPI Thresholds (0-10)
MIN_CONSISTENCY_SCORE=7
MIN_PROSE_QUALITY_SCORE=7
MIN_EMOTIONAL_SCORE=6

# Max Iteration per Chapter
MAX_ITERATIONS=3
